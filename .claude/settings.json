{
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "grrr hook notify --appId Dotfiles"
          }
        ]
      }
    ],
    "Notification": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "grrr hook notify --appId Dotfiles"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "grrr hook dismiss --appId Dotfiles"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"/opt/homebrew/bin/sideband\" hook prompt --agent claude"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "clear",
        "hooks": [
          {
            "type": "command",
            "command": "\"/opt/homebrew/bin/sideband\" hook session-start --agent claude"
          }
        ]
      }
    ]
  }
}
